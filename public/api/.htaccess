# Nasconde i file di configurazione: non devono mai essere scaricabili dal browser
<FilesMatch "^(config\.php|\.rate_.*|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Niente elenco dei file nella cartella
Options -Indexes
